{
    "name": "padosoft/laravel-rebel-email-otp",
    "description": "Login passwordless email-OTP enterprise per Laravel Rebel: anti-enumeration, rate-limit multidimensionale, multi-tenant/purpose/risk, emissione token Sanctum. Parte di padosoft/laravel-rebel-*.",
    "keywords": ["laravel", "authentication", "otp", "passwordless", "email", "login", "padosoft", "rebel"],
    "homepage": "https://github.com/padosoft/laravel-rebel-email-otp",
    "license": "MIT",
    "authors": [
        {
            "name": "Padosoft",
            "email": "support@padosoft.com",
            "homepage": "https://www.padosoft.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "padosoft/laravel-rebel-core": "^0.1",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/padosoft/laravel-rebel-core"
        }
    ],
    "autoload": {
        "psr-4": {
            "Padosoft\\Rebel\\EmailOtp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Padosoft\\Rebel\\EmailOtp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Padosoft\\Rebel\\EmailOtp\\RebelEmailOtpServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage",
        "phpstan": "phpstan analyse",
        "pint": "pint",
        "check": [
            "@pint --test",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
