# ─────────────────────────────────────────────────────────────────────────────
# padosoft/laravel-rebel-email-otp — environment variables
# ─────────────────────────────────────────────────────────────────────────────

# --- OTP ---
REBEL_OTP_DIGITS=6              # code digits (8 for high assurance)
REBEL_OTP_TTL=600              # validity in seconds (NIST max: 600)
REBEL_OTP_MAX_ATTEMPTS=5       # verification attempts per challenge
REBEL_OTP_MAX_RESENDS=3        # maximum resends
REBEL_OTP_RESEND_COOLDOWN=30   # seconds between two resends
REBEL_OTP_STORE=database       # 'database' (lock) or 'redis' (Lua)
REBEL_OTP_TIMING_TARGET_MS=250 # anti-enumeration timing normalisation

# --- Core pepper (HMAC) ---  generate: php -r "echo bin2hex(random_bytes(32));"
REBEL_PEPPER_V1=
REBEL_PEPPER_CURRENT=1

# --- Email for "live" tests (Mailtrap, free) ---
# Create an inbox at https://mailtrap.io → Email Testing → SMTP/API credentials.
# The "live" test group runs only if these variables are present.
MAILTRAP_API_HOST=sandbox.api.mailtrap.io
MAILTRAP_APIKEY=
MAILTRAP_INBOXID=
MAILTRAP_SMTP_MAILER=smtp
MAILTRAP_SMTP_MAIL_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_MAIL_PORT=2525
MAILTRAP_SMTP_MAIL_USERNAME=
MAILTRAP_SMTP_MAIL_PASSWORD=
