# ─────────────────────────────────────────────────────────────────────────────
# padosoft/laravel-rebel-email-otp — variabili d'ambiente
# ─────────────────────────────────────────────────────────────────────────────

# --- OTP ---
REBEL_OTP_DIGITS=6              # cifre del codice (8 per alta assurance)
REBEL_OTP_TTL=600              # validità in secondi (max NIST: 600)
REBEL_OTP_MAX_ATTEMPTS=5       # tentativi di verifica per challenge
REBEL_OTP_MAX_RESENDS=3        # reinvii massimi
REBEL_OTP_RESEND_COOLDOWN=30   # secondi tra due reinvii
REBEL_OTP_STORE=database       # 'database' (lock) o 'redis' (Lua)
REBEL_OTP_TIMING_TARGET_MS=250 # normalizzazione timing anti-enumeration

# --- Pepper del core (HMAC) ---  genera: php -r "echo bin2hex(random_bytes(32));"
REBEL_PEPPER_V1=
REBEL_PEPPER_CURRENT=1

# --- Email per i test "live" (Mailtrap, free) ---
# Crea un inbox su https://mailtrap.io → Email Testing → SMTP/API credentials.
# I test del gruppo "live" girano solo se queste variabili sono presenti.
MAILTRAP_API_HOST=sandbox.api.mailtrap.io
MAILTRAP_APIKEY=
MAILTRAP_INBOXID=
MAILTRAP_SMTP_MAILER=smtp
MAILTRAP_SMTP_MAIL_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_MAIL_PORT=2525
MAILTRAP_SMTP_MAIL_USERNAME=
MAILTRAP_SMTP_MAIL_PASSWORD=
